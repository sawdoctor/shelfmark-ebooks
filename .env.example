# Container identity
PUID=1000
PGID=1000
TZ=Etc/UTC
SHELFMARK_PORT=8086

# Host paths. Relative defaults keep a test installation self-contained.
SHELFMARK_CONFIG_DIR=./config
EBOOK_LIBRARY_DIR=./books
SAB_DOWNLOADS_DIR=./downloads

# Existing services reachable from the Shelfmark container.
PROWLARR_URL=http://prowlarr:9696
PROWLARR_API_KEY=
SABNZBD_URL=http://sabnzbd:8080
SABNZBD_API_KEY=
SABNZBD_CATEGORY=books

# Optional overrides
# SHELFMARK_IMAGE=ghcr.io/calibrain/shelfmark:v1.4.0
# SEARCH_PAGE_TITLE=Shelfmark eBooks
# SUPPORTED_FORMATS=epub,pdf
# BOOK_LANGUAGE=en
# FILE_ORGANIZATION=organize
# PROWLARR_USENET_ACTION=move
